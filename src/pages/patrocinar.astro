---
import { u } from '../data/meta.js'; import casos from '../data/casos.json';
import Base from '../layouts/Base.astro'; import SponsorCard from '../components/SponsorCard.astro';
import TallyForm from '../components/TallyForm.astro'; import { TALLY } from '../data/config.mjs';
const formatos=[
['Hueco en el listado','Tarjeta fija en la home y en «Nuevos», con el mismo formato que un caso y la etiqueta «Patrocinado».'],
['Patrocinio de sector','Tu tarjeta en la página de un sector (por ejemplo Hostelería o Inmobiliaria), marcada como «Patrocinado».'],
['Mención en la newsletter','Bloque único y marcado al principio de «Los 5 del lunes», cuando la newsletter tenga envíos con apertura medida.'],
['Caso patrocinado','Ficha de un cliente real e identificable, con fuente pública y la misma revisión que cualquier caso. Va marcada como «Patrocinado».']];
---
<Base title="Patrocinar: plaza de fundador" description="Plaza de fundador para patrocinar CasosAgentes: llega a autónomos y pymes de España que buscan casos reales de IA. Todo patrocinio va siempre marcado." crumbs={[{name:'Patrocinar'}]} jsonld={{"@context":"https://schema.org","@type":"WebPage","name":"Patrocinar","inLanguage":"es-ES"}}>
<section class="hero"><span class="eyebrow">Patrocinio · Siempre marcado como «Patrocinado»</span><h1>Plaza de fundador</h1><p>Llega a autónomos, gestorías, clínicas, inmobiliarias y comercios de España en el momento en que buscan cómo aplicar IA a su negocio.</p>
<p class="stats">{casos.length} casos publicados · Sitio en lanzamiento: todavía no publicamos cifras de tráfico ni precios cerrados. Los publicaremos aquí cuando haya al menos un mes de datos medidos, con su fecha.</p></section>
<h2>Qué es la plaza de fundador</h2>
<p>Para los primeros patrocinadores: el precio se acuerda con cada uno y se revisa al renovar, con datos reales de tráfico y de la newsletter delante. Sin cifras infladas ni promesas de audiencia.</p>
<div class="grid planes">{formatos.map(([t,d])=><div class="card"><span class="splbl" style="align-self:flex-start">Patrocinado</span><h3>{t}</h3><p>{d}</p><span class="src">Precio: a convenir (plaza de fundador)</span></div>)}</div>
<h2>Así se ve un hueco patrocinado</h2><div class="grid" style="max-width:420px"><SponsorCard /></div>
<h2>Reglas que no se negocian</h2><ul>
<li><strong>El patrocinador no toca el contenido.</strong> No decide qué casos entran, no cambia cifras ni textos y no puede pedir que se quite o se reordene un caso, propio o de la competencia. Solo puede pedir correcciones de hechos aportando una fuente.</li>
<li><strong>Todo lo pagado se marca como «Patrocinado (Marca)»</strong> (LSSI art. 20) y queda fuera de Destacados.</li>
<li><strong>Si un proveedor nos patrocina, sus casos lo dicen:</strong> se marcan como patrocinados («Este proveedor patrocina CasosAgentes»), también los publicados antes del acuerdo.</li>
<li>Pagar no da entrada a ningún caso: todos pasan los mismos criterios de la <a href={u("/metodologia")}>metodología</a> (negocio identificable, pyme o autónomo de España, fuente pública, cifras literales).</li>
<li>Solo aceptamos productos útiles para pymes y autónomos de España. Detalle en <a href={u("/transparencia")}>Cómo nos financiamos</a>.</li></ul>
<h2>Solicita la plaza de fundador</h2>
<TallyForm id={TALLY.patrocinar} titulo="Formulario: plaza de fundador" asunto="Plaza de fundador CasosAgentes" cuerpo={"Empresa y web:\nProducto o servicio:\nFormato que te interesa:\n"} que="El formulario de patrocinio" />
</Base>
