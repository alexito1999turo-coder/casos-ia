---
import Landing from '../../components/Landing.astro'; import casos from '../../data/casos.json'; import { ciudadSlug, ciudadNombre } from '../../data/meta.js';
export function getStaticPaths(){ return [...new Set(casos.map(ciudadSlug).filter(Boolean))].map(k=>({params:{slug:k},props:{k,n:ciudadNombre(k)}})); }
const { k, n } = Astro.props; const cs = casos.filter(c=>ciudadSlug(c)===k);
---
<Landing titulo={`Casos de IA en negocios de ${n}`} h1={`Negocios de ${n} que ya usan agentes de IA`} intro={`Casos reales de autónomos y pymes de ${n} que han aplicado IA, con resultado, prompt y fuente.`} casos={cs} path={`/ciudad/${k}/`} />
