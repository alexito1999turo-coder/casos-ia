---
import Landing from '../../components/Landing.astro'; import casos from '../../data/casos.json'; import { slugify } from '../../data/meta.js';
export function getStaticPaths(){ return [...new Set(casos.map(c=>c.ciudad).filter(Boolean))].map(n=>({params:{slug:slugify(n)},props:{n}})); }
const { n } = Astro.props; const cs = casos.filter(c=>c.ciudad===n);
---
<Landing titulo={`Casos de IA en negocios de ${n}`} h1={`Negocios de ${n} que ya usan agentes de IA`} intro={`Casos reales de autónomos y pymes de ${n} que han aplicado IA, con resultado, prompt y fuente.`} casos={cs} path={`/ciudad/${slugify(n)}/`} />
