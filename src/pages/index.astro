---
import Base from '../layouts/Base.astro'; import Buscador from '../components/Buscador.astro';
import casos from '../data/casos.json'; import { SECTORES, TAREAS, SITE, u, herrBase, HERR, herrMain } from '../data/meta.js';
const orden = [...casos].sort((a,b)=>b.publicado.localeCompare(a.publicado));
const nRes=casos.filter(c=>c.resultado&&!c.patrocinado&&c.fuenteTipo!=="proveedor"&&c.destacable!==false).length;
const ult = orden[0].publicado; const nUlt = casos.filter(c=>c.publicado===ult).length;
const fmt = d => new Date(d).toLocaleDateString('es-ES',{weekday:'short',day:'numeric',month:'short'});
const HOME_DESC = 'El directorio de casos reales de IA en pymes y autónomos de España, con nombre y fuente: qué hicieron, el resultado y el prompt para copiarlo.';
const jsonld = [{"@context":"https://schema.org","@type":"WebSite","name":SITE.nombre,"url":SITE.url+'/',"inLanguage":"es-ES","description":HOME_DESC},{"@context":"https://schema.org","@type":"ItemList","itemListElement":orden.map((c,i)=>({"@type":"ListItem","position":i+1,"url":`${SITE.url}/casos/${c.slug}/`,"name":c.titulo}))}];
---
<Base jsonld={jsonld} description={HOME_DESC}>
<section class="hero"><span class="eyebrow">Directorio · España · Actualizado {fmt(ult)}</span><h1>Lo que autónomos y pymes en España <em>ya hacen</em> con agentes de IA</h1>
<p class="claim"><strong>El directorio de casos reales de pymes y autónomos de España, con nombre y fuente, y ciudad cuando la fuente la da.</strong> Sin casos anónimos y sin tutoriales.</p>
<p>Cada caso trae el resultado tal como lo publica la fuente, un prompt para copiar y notas para España (Hacienda, Verifactu, WhatsApp Business, Idealista). <strong>Copia la idea.</strong></p>
<p class="stats">{casos.length} casos · Fuentes: blogs, prensa, LinkedIn y X en español · <a href={u("/feed.xml")}>RSS</a></p>
<div class="ctas"><a class="btn" href={u("/newsletter")}>Recibe los casos nuevos</a><a class="btn ghost" href={u("/enviar-caso")}>Enviar un caso</a></div></section>
<div class="strip"><span class="dot" aria-hidden="true"></span><strong>{nUlt} {nUlt===1?'caso nuevo':'casos nuevos'}</strong><span class="stats">{fmt(ult)}</span><a href={u("/nuevos")} style="margin-left:auto">Ver los nuevos →</a></div>
<Buscador orden={orden} nRes={nRes} />
</Base>
