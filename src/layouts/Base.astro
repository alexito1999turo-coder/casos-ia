---
import { SITE , u, ORIGIN } from '../data/meta.js';
import { recorta } from '../data/meta.js';
const { title, rawTitle, description = SITE.desc, jsonld, robots = 'index,follow', ogType = 'website', published, crumbs } = Astro.props;
let canonical = new URL(Astro.url.pathname, ORIGIN).href; if (!canonical.endsWith('/')) canonical += '/';
const full = rawTitle ?? (title ? (`${title} | ${SITE.nombre}`.length <= 60 ? `${title} | ${SITE.nombre}` : title) : `${SITE.nombre} · Casos reales de IA para pymes`);
const desc = recorta(description, 155);
const ogImage = `${SITE.url}/og.png`;
const bc = crumbs && { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{name:'Inicio',href:'/'},...crumbs].map((c,i)=>({"@type":"ListItem","position":i+1,"name":c.name,...(c.href?{"item":`${SITE.url}${c.href}`}:{})})) };
const lds = [ ...(jsonld ? (Array.isArray(jsonld)?jsonld:[jsonld]) : []), ...(bc?[bc]:[]) ];
---
<!doctype html><html lang="es-ES"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{full}</title><meta name="description" content={desc}><meta name="robots" content={robots}><link rel="canonical" href={canonical}>
<meta property="og:title" content={full}><meta property="og:description" content={desc}><meta property="og:type" content={ogType}><meta property="og:image" content={ogImage}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:site_name" content="CasosAgentes">{published && <meta property="article:published_time" content={published}>}<meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content={ogImage}><meta property="og:url" content={canonical}><meta property="og:locale" content="es_ES">
<link rel="alternate" type="text/plain" href={u("/llms.txt")} title="llms.txt">
{lds.map(j=><script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<style is:global>
:root{--bg:#fff;--fg:#0a0a0a;--muted:#4a4a4a;--faint:#6b6b6b;--line:#e2e2e2;--line2:#0a0a0a;--hatch:#f5f5f5;--accent:#000;--ok:#0a7a3d;--warn:#9a6700;--mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;--r:0px}
:root.dark{--bg:#0a0a0a;--fg:#f2f2f2;--muted:#b0b0b0;--faint:#8a8a8a;--line:#262626;--line2:#f2f2f2;--hatch:#141414;--accent:#fff;--ok:#4ade80;--warn:#fbbf24}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%;color-scheme:light}:root.dark{color-scheme:dark}
body{margin:0;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--fg);background:var(--bg);line-height:1.55;font-feature-settings:"cv11","ss01";-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{color:inherit;text-underline-offset:3px;text-decoration-thickness:1px}:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
html,body{overflow-x:clip}header{border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:saturate(1.4) blur(10px)}
footer{border-top:1px solid var(--line);color:var(--muted)}header a,footer a{text-decoration:none}header a:hover,footer a:hover{text-decoration:underline}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
nav.top{display:flex;gap:4px 18px;align-items:center;height:56px;font-size:.88rem}
nav.top .links{display:flex;gap:18px;overflow-x:auto;min-width:0;scrollbar-width:none;white-space:nowrap;margin-left:auto}nav.top .links::-webkit-scrollbar{display:none}
nav.top .links a{color:var(--muted)}nav.top .links a:hover{color:var(--fg)}nav.top .links a.cta{color:var(--bg);background:var(--accent);padding:5px 11px;text-decoration:none}
.logo{font-weight:700;font-size:1.05rem;letter-spacing:-.03em;white-space:nowrap}.logo span{color:var(--faint);font-weight:500}
#theme{background:none;border:1px solid var(--line);color:var(--fg);width:32px;height:32px;padding:0;display:grid;place-items:center;flex:none}
@media(max-width:760px){nav.top{flex-wrap:wrap;height:auto;padding:10px 0 0}nav.top .links{order:3;flex:1 0 100%;max-width:100%;margin:0;padding:8px 0 10px;gap:16px}nav.top .logo{min-width:0}#theme{margin-left:auto}}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:0;border-top:1px solid var(--line);border-left:1px solid var(--line)}
@media(max-width:700px){.grid{grid-template-columns:1fr;border-left:0;margin:0 -20px}.grid>.card{border-right:0;padding:18px 20px}}
.card{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:20px;display:flex;flex-direction:column;gap:10px;background:var(--bg);position:relative;transition:background .15s}
.card:hover{background:var(--hatch)}
.card h3{margin:0;font-size:1.04rem;line-height:1.3;letter-spacing:-.015em;font-weight:650}.card h3 a{text-decoration:none}.card h3 a::after{content:"";position:absolute;inset:0}.card h3 a:hover{text-decoration:underline}
.card .meta a,.card .acts,.card details,.card .tag,.card .head,.card .head a{position:relative;z-index:1}
.card p{margin:0;color:var(--muted);font-size:.9rem}.card .sum{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.card.sp{background:repeating-linear-gradient(135deg,var(--hatch) 0 1px,var(--bg) 1px 9px)}
.splbl{font:600 .66rem/1 var(--mono);text-transform:uppercase;letter-spacing:.08em;border:1px solid var(--line2);padding:4px 6px}
.badge{width:36px;height:36px;border:1px solid var(--line2);display:grid;place-items:center;font:700 .74rem var(--mono);letter-spacing:.02em;flex:none;background:var(--bg)}
.head{display:flex;gap:10px;align-items:center}.head .who{display:flex;flex-direction:column;line-height:1.2;min-width:0}.head .who a{font-size:.82rem;font-weight:600;text-decoration:none}.head .who small{font:.7rem var(--mono);color:var(--faint);text-transform:uppercase;letter-spacing:.06em}.head .new{margin-left:auto}
.meta{font-size:.76rem;color:var(--faint);display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.tag{display:inline-block;border:1px solid var(--line);padding:1px 8px;font-size:.74rem;text-decoration:none;color:var(--muted);white-space:nowrap}a.tag:hover{border-color:var(--line2);color:var(--fg)}
.new{background:var(--accent);color:var(--bg);padding:2px 6px;font:600 .64rem/1.2 var(--mono);text-transform:uppercase;letter-spacing:.06em}
.new.prov{background:transparent;color:var(--fg);border:1px solid currentColor}.new.pat{background:#b45309;color:#fff}
.res{border-left:2px solid var(--ok);padding:2px 0 2px 10px;font-size:.88rem;font-weight:550;color:var(--fg)!important;font-variant-numeric:tabular-nums}.res.none{border-color:var(--warn);font-weight:400;color:var(--muted)!important}
.card .res{display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden}
.src{font:.7rem var(--mono);color:var(--faint);text-transform:uppercase;letter-spacing:.04em}
.acts{display:flex;gap:6px;margin-top:auto;padding-top:4px;flex-wrap:wrap}.acts button,.acts a{font-size:.78rem;padding:5px 10px;background:none;color:var(--fg);border:1px solid var(--line);text-decoration:none;min-height:32px}.acts button:hover,.acts a:hover{border-color:var(--line2)}
.acts .on{background:var(--accent);color:var(--bg);border-color:var(--accent)}
details summary{cursor:pointer;font-size:.8rem;color:var(--muted);list-style:none}details summary::before{content:"+ ";font-family:var(--mono)}details[open] summary::before{content:"− "}
details pre{margin:6px 0 0;max-height:220px;overflow:auto}
pre{white-space:pre-wrap;background:var(--hatch);color:var(--fg);border:1px solid var(--line);padding:14px;font:.83rem/1.6 var(--mono)}
button,.btn{background:var(--accent);color:var(--bg);border:1px solid var(--accent);padding:9px 16px;cursor:pointer;font-size:.9rem;font-weight:550;text-decoration:none;display:inline-block;font-family:inherit}
.btn.ghost{background:none;color:var(--fg);border-color:var(--line2)}
input,select,textarea{padding:10px 12px;border:1px solid var(--line);background:var(--bg);color:var(--fg);font-size:16px;width:100%;font-family:inherit;border-radius:0;-webkit-appearance:none;appearance:none}
select{background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);background-position:calc(100% - 16px) 50%,calc(100% - 11px) 50%;background-size:5px 5px;background-repeat:no-repeat;padding-right:30px}
input:focus,select:focus{outline:none;border-color:var(--line2)}
.fbar{position:sticky;top:56px;z-index:10;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 0;margin:8px 0 0}
.filters{display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:8px}.filters #clr{background:none;color:var(--fg);border-color:var(--line)}
.fmeta{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;font:.74rem var(--mono);color:var(--faint);text-transform:uppercase;letter-spacing:.05em;padding:8px 0 0}.fmeta label{display:flex;gap:6px;align-items:center;cursor:pointer}.fmeta input{width:auto;-webkit-appearance:auto;appearance:auto}
@media(max-width:760px){.fbar{top:88px}.filters{grid-template-columns:1fr 1fr 1fr;gap:6px}.filters select{font-size:16px;padding:8px 24px 8px 8px}.filters #q{grid-column:1/3}.filters #clr{grid-column:3;padding:8px}}
main{padding:28px 0 56px}footer{padding:28px 0;font-size:.82rem;line-height:1.7}
.hero{padding:28px 0 20px;max-width:780px}.hero h1{font-size:clamp(1.9rem,4.6vw,3.1rem);margin:0 0 14px;letter-spacing:-.04em;line-height:1.04;font-weight:750}.hero h1 em{font-style:normal;color:var(--faint)}
.hero p{font-size:1.04rem;color:var(--muted);margin:0 0 14px;max-width:640px}.hero .ctas{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.eyebrow{font:600 .7rem var(--mono);text-transform:uppercase;letter-spacing:.1em;color:var(--faint);display:block;margin-bottom:10px}
.stats{color:var(--faint);font-size:.84rem;font-variant-numeric:tabular-nums}.box{border:1px solid var(--line);padding:16px;margin:16px 0}.cols{columns:2 260px}
.strip{display:flex;gap:10px 16px;align-items:center;flex-wrap:wrap;border:1px solid var(--line);padding:10px 14px;font-size:.88rem}.strip .dot{width:7px;height:7px;background:var(--ok);display:inline-block;border-radius:50%}
.crumbs{font-size:.8rem;color:var(--faint);padding:0 0 14px;display:block}.crumbs a{text-decoration:none}.resumen{border:1px solid var(--line);padding:14px 16px;background:var(--hatch);font-size:.92rem}
h1,h2{letter-spacing:-.025em}h2{font-size:1.15rem;margin:32px 0 10px}
.ficha{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:48px;align-items:start}.ficha h1{font-size:clamp(1.6rem,3.4vw,2.4rem);line-height:1.1;margin:14px 0 16px}.ficha .body{max-width:720px}
.ficha aside{position:sticky;top:76px;border:1px solid var(--line);padding:18px;display:flex;flex-direction:column;gap:12px;font-size:.88rem}.ficha aside dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 12px}.ficha aside dt{font:.7rem var(--mono);text-transform:uppercase;color:var(--faint);padding-top:3px}.ficha aside dd{margin:0}
@media(max-width:900px){.ficha{grid-template-columns:1fr;gap:8px}.ficha aside{position:static;order:-1}}
.planes .card .price{font-size:1.5rem;font-weight:750;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:28px;align-items:start;margin-top:8px}.mob{display:none!important}
.side{position:sticky;top:72px;max-height:calc(100vh - 88px);overflow:auto;font-size:.86rem;padding-top:10px;scrollbar-width:thin}
.side details{border-top:1px solid var(--line);padding:10px 0}.side summary{font:600 .7rem var(--mono);text-transform:uppercase;letter-spacing:.08em;color:var(--faint);margin-bottom:6px}
.side ul{list-style:none;margin:0;padding:0}.side li button{all:unset;box-sizing:border-box;cursor:pointer;display:flex;justify-content:space-between;width:100%;padding:5px 8px;color:var(--muted)}
.side li button span{font:.74rem var(--mono);color:var(--faint);font-variant-numeric:tabular-nums}.side li button:hover{background:var(--hatch);color:var(--fg)}.side li button.on{background:var(--accent);color:var(--bg)}.side li button.on span{color:var(--bg)}
.side li button:focus-visible{outline:2px solid var(--accent)}
.sort{display:inline-flex;margin-left:auto;border:1px solid var(--line)}.sort button,.fmeta .mob{background:none;color:var(--muted);border:0;padding:4px 10px;font:600 .7rem var(--mono);text-transform:uppercase;letter-spacing:.06em}.fmeta .mob{border:1px solid var(--line);color:var(--fg)}.sort button.on{background:var(--accent);color:var(--bg)}
.maincol .fbar{margin-top:0}
@media(max-width:900px){.layout{grid-template-columns:1fr;gap:0}.mob{display:revert!important}.side .sidehead{display:flex!important;justify-content:space-between;align-items:center;padding:4px 0 10px}.side .sidehead button{background:none;color:var(--fg);border:1px solid var(--line);padding:4px 10px}
.side{position:fixed;top:0;left:0;bottom:0;width:min(86vw,320px);max-height:none;z-index:50;background:var(--bg);border-right:1px solid var(--line2);padding:16px 20px;transform:translateX(-102%);transition:transform .2s}.side.open{transform:none}
#scrim{position:fixed;inset:0;background:rgb(0 0 0/.45);z-index:40}#scrim[hidden]{display:none!important}}
</style>
<script is:inline>if(localStorage.theme==='dark'||(!localStorage.theme&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark')</script>
<link rel="alternate" type="application/rss+xml" title="CasosAgentes" href={u("/feed.xml")}></head><body>
<header><div class="wrap"><nav class="top" aria-label="Principal"><a class="logo" href={u("/")}>Casos<span>Agentes</span>.es</a><div class="links"><a href={u("/nuevos")}>Nuevos</a><a href={u("/herramientas")}>Herramientas</a><a href={u("/categorias")}>Categorías</a><a href={u("/newsletter")}>Newsletter</a><a href={u("/patrocinar")}>Patrocinar</a><a class="cta" href={u("/enviar-caso")}>Enviar caso</a></div><button id="theme" aria-label="Cambiar tema claro/oscuro">◐</button></nav></div></header>
<main class="wrap">{crumbs && <nav class="crumbs" aria-label="Migas de pan"><a href={u("/")}>Inicio</a>{crumbs.map(c=><Fragment> › {c.href?<a href={u(c.href)}>{c.name}</a>:<span aria-current="page">{c.name}</span>}</Fragment>)}</nav>}<slot /></main>
<footer><div class="wrap">CasosAgentes · Casos reales de IA para autónomos y pymes en España. Las cifras son las que publica cada fuente; no las verificamos de forma independiente. · <a href={u("/llms.txt")}>llms.txt</a> · <a href={u("/sitemap-index.xml")}>sitemap</a> · <a href={u("/feed.xml")}>RSS</a> · <a href={u("/metodologia")}>Metodología</a> · <a href={u("/sobre")}>Sobre</a> · <a href={u("/privacidad")}>Privacidad</a></div></footer>
<script is:inline>document.getElementById('theme').onclick=()=>{const d=document.documentElement.classList.toggle('dark');localStorage.theme=d?'dark':'light'}</script>
</body></html>
