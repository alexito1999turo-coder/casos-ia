---
import { SITE , u, ORIGIN } from '../data/meta.js';
import { recorta } from '../data/meta.js';
const { title, rawTitle, description = SITE.desc, jsonld, robots = 'index,follow', ogType = 'website', published, crumbs } = Astro.props;
let canonical = new URL(Astro.url.pathname, ORIGIN).href; if (!canonical.endsWith('/')) canonical += '/';
const full = rawTitle ?? (title ? (`${title} | ${SITE.nombre}`.length <= 60 ? `${title} | ${SITE.nombre}` : title) : `${SITE.nombre} · Casos reales de IA para pymes`);
const desc = recorta(description, 155);
const ogImage = `${SITE.url}/og.png`;
const bc = crumbs && { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{name:'Inicio',href:'/'},...crumbs].map((c,i)=>({"@type":"ListItem","position":i+1,"name":c.name,...(c.href?{"item":`${SITE.url}${c.href}`}:{})})) };
const lds = [ ...(jsonld ? (Array.isArray(jsonld)?jsonld:[jsonld]) : []), ...(bc?[bc]:[]) ];
---
<!doctype html><html lang="es-ES"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{full}</title><meta name="description" content={desc}><meta name="robots" content={robots}><link rel="canonical" href={canonical}>
<meta property="og:title" content={full}><meta property="og:description" content={desc}><meta property="og:type" content={ogType}><meta property="og:image" content={ogImage}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:site_name" content="CasosAgentes">{published && <meta property="article:published_time" content={published}>}<meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content={ogImage}><meta property="og:url" content={canonical}><meta property="og:locale" content="es_ES">
<link rel="alternate" type="text/plain" href={u("/llms.txt")} title="llms.txt">
{lds.map(j=><script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<style is:global>
:root{--bg:#fff;--fg:#0a0a0a;--muted:#525252;--faint:#6b6b6b;--line:#d4d4d4;--hatch:#f2f2f2;--accent:#000;--ok:#0a7a3d;--warn:#9a6700}
:root.dark{--bg:#000;--fg:#f5f5f5;--muted:#a3a3a3;--faint:#858585;--line:#262626;--hatch:#141414;--accent:#fff;--ok:#4ade80;--warn:#fbbf24}
*{box-sizing:border-box}body{margin:0;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--fg);background:var(--bg);line-height:1.5}
a{color:inherit}header{border-bottom:1px solid var(--line)}footer{border-top:1px solid var(--line);color:var(--muted)}header a,footer a{text-decoration:none}header a:hover,footer a:hover{text-decoration:underline}
.wrap{max-width:1100px;margin:0 auto;padding:0 18px}nav{display:flex;gap:16px;align-items:center;padding:14px 0;flex-wrap:wrap;font-size:.92rem}
.logo{font-weight:700;font-size:1.15rem;margin-right:auto;letter-spacing:-.02em}.logo span{color:var(--faint)}
#theme{background:none;border:1px solid var(--line);color:var(--fg);padding:4px 9px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:0;border-top:1px solid var(--line);border-left:1px solid var(--line)}
.card{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px;display:flex;flex-direction:column;gap:8px;background:var(--bg)}
.card h3{margin:0;font-size:1.02rem;line-height:1.3}.card h3 a{text-decoration:none}.card h3 a:hover{text-decoration:underline}
.card p{margin:0;color:var(--muted);font-size:.9rem}.card.sp{background:repeating-linear-gradient(45deg,var(--hatch) 0 6px,var(--bg) 6px 12px)}
.badge{width:32px;height:32px;border:1px solid var(--line);display:grid;place-items:center;font:600 .72rem ui-monospace,monospace;flex:none}
.meta{font-size:.78rem;color:var(--faint);display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.tag{display:inline-block;border:1px solid var(--line);padding:1px 8px;font-size:.75rem;margin:0 4px 4px 0;text-decoration:none;color:var(--muted)}
.new{background:var(--accent);color:var(--bg);padding:0 6px;font-size:.7rem;font-weight:600}
.new.prov{background:transparent;color:var(--fg,inherit);border:1px solid currentColor}.new.pat{background:#b45309;color:#fff}
.res{border-left:3px solid var(--ok);padding:4px 10px;font-size:.9rem;font-weight:600;color:var(--fg)!important}.res.none{border-color:var(--warn);font-weight:400;color:var(--muted)!important}
.acts{display:flex;gap:6px;margin-top:auto;flex-wrap:wrap}.acts button,.acts a{font-size:.8rem;padding:4px 10px;background:none;color:var(--fg);border:1px solid var(--line)}
.acts .on{background:var(--accent);color:var(--bg)}
details pre{margin:6px 0 0;max-height:220px;overflow:auto}
pre{white-space:pre-wrap;background:var(--hatch);color:var(--fg);border:1px solid var(--line);padding:14px;font:.85rem/1.5 ui-monospace,monospace}
button,.btn{background:var(--accent);color:var(--bg);border:1px solid var(--accent);padding:8px 16px;cursor:pointer;font-size:.92rem;text-decoration:none;display:inline-block;font-family:inherit}
input,select,textarea{padding:9px;border:1px solid var(--line);background:var(--bg);color:var(--fg);font-size:.95rem;width:100%;font-family:inherit}
.filters{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:8px;margin:16px 0}@media(max-width:700px){.filters{grid-template-columns:1fr}}
main{padding:24px 0 48px}footer{padding:24px 0;font-size:.85rem}.hero{padding:28px 0 8px}.hero h1{font-size:2.1rem;margin:0;letter-spacing:-.03em;line-height:1.1}
.stats{color:var(--faint);font-size:.85rem}.box{border:1px solid var(--line);padding:16px;margin:16px 0}.cols{columns:2 260px}
.crumbs{font-size:.82rem;color:var(--faint);padding:0 0 10px;display:block}.crumbs a{text-decoration:none}.resumen{border:1px solid var(--line);padding:12px 14px;background:var(--hatch)}
h1,h2{letter-spacing:-.02em}h2{font-size:1.2rem;margin-top:28px}
</style>
<script is:inline>if(localStorage.theme==='dark'||(!localStorage.theme&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark')</script>
<link rel="alternate" type="application/rss+xml" title="CasosAgentes" href={u("/feed.xml")}></head><body>
<header><div class="wrap"><nav><a class="logo" href={u("/")}>Casos<span>Agentes</span>.es</a><a href={u("/nuevos")}>Nuevos</a><a href={u("/herramientas")}>Herramientas</a><a href={u("/categorias")}>Categorías</a><a href={u("/newsletter")}>Newsletter</a><a href={u("/patrocinar")}>Patrocinar</a><a href={u("/enviar-caso")}>Enviar caso</a><button id="theme" aria-label="Cambiar tema">◐</button></nav></div></header>
<main class="wrap">{crumbs && <nav class="crumbs" aria-label="Migas de pan"><a href={u("/")}>Inicio</a>{crumbs.map(c=><Fragment> › {c.href?<a href={u(c.href)}>{c.name}</a>:<span aria-current="page">{c.name}</span>}</Fragment>)}</nav>}<slot /></main>
<footer><div class="wrap">CasosAgentes · Casos reales de IA para autónomos y pymes en España. Las cifras son las que publica cada fuente; no las verificamos de forma independiente. · <a href={u("/llms.txt")}>llms.txt</a> · <a href={u("/sitemap-index.xml")}>sitemap</a> · <a href={u("/feed.xml")}>RSS</a> · <a href={u("/metodologia")}>Metodología</a> · <a href={u("/sobre")}>Sobre</a> · <a href={u("/privacidad")}>Privacidad</a></div></footer>
<script is:inline>document.getElementById('theme').onclick=()=>{const d=document.documentElement.classList.toggle('dark');localStorage.theme=d?'dark':'light'}</script>
</body></html>
