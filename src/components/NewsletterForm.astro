---
import { mlAction } from '../data/config.mjs';
import Fallback from './Fallback.astro';
import { u } from '../data/meta.js';
const action = mlAction();
---
{action ? <form class="nlf" method="post" action={action} style="max-width:460px;display:grid;gap:10px" data-ml>
<input type="email" name="fields[email]" required placeholder="tu@email.com" aria-label="Email" autocomplete="email">
<input type="hidden" name="ml-submit" value="1"><input type="hidden" name="anticsrf" value="true">
<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px">
<label style="display:flex;gap:8px;align-items:flex-start;font-size:.86rem"><input type="checkbox" name="gdpr[]" value="newsletter" required style="width:auto;-webkit-appearance:auto;appearance:auto;margin-top:4px"> <span>Acepto recibir «Los 5 del lunes» por email y he leído la <a href={u("/privacidad")}>política de privacidad</a>.</span></label>
<p class="rgpd" style="margin:0"><small><strong>Protección de datos.</strong> Responsable: el titular de CasosAgentes (<a href={u('/aviso-legal')}>aviso legal</a>). Finalidad: enviarte la newsletter. Base: tu consentimiento. Encargado del tratamiento: MailerLite Limited (Irlanda), que mide aperturas y clics de cada envío. Te pediremos confirmar tu email (doble opt-in) y puedes retirar tu consentimiento y darte de baja en cualquier envío. Más en <a href={u('/privacidad')}>privacidad</a>.</small></p>
<button type="submit">Suscribirme</button><p class="nlmsg" role="status" aria-live="polite" style="margin:0"></p></form>
: <Fallback asunto="Alta en la newsletter «Los 5 del lunes»" cuerpo="Quiero recibir la newsletter en este email." que="La suscripción a la newsletter" activo="activa" />}
{action && <script is:inline>
document.querySelectorAll('form[data-ml]').forEach(f=>f.addEventListener('submit',async e=>{e.preventDefault();const m=f.querySelector('.nlmsg'),b=f.querySelector('button');if(f.website.value)return;b.disabled=true;m.textContent='Enviando…';
try{const r=await fetch(f.action,{method:'POST',body:new FormData(f),headers:{Accept:'application/json'}});const j=await r.json().catch(()=>({}));
if(r.ok&&j.success!==false){f.querySelectorAll('input,label,.rgpd,button').forEach(x=>x.hidden=true);m.textContent='Casi está: te hemos enviado un email para confirmar la suscripción.'}else{m.textContent='No se ha podido completar el alta. Revisa el email e inténtalo de nuevo.';b.disabled=false}}
catch(_){m.textContent='No se ha podido conectar con el servicio de envío. Inténtalo más tarde.';b.disabled=false}}));
</script>}
