---
import { etiquetaInst } from "../data/meta.js";
import { SECTORES, TAREAS, u, slugify, herrBase, iniciales, HERR, herrMain, ciudadSlug } from '../data/meta.js';
const { c } = Astro.props;
const norm = s => String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const esNuevo = (Date.parse('2026-10-16') - Date.parse(c.publicado)) < 7*864e5;
const TIPO_LBL = { prensa:'Prensa', cliente:'Fuente: el propio negocio', 'red social':'Redes sociales' };
const fuenteLbl = c.patrocinado ? `Contenido patrocinado (${c.patrocinado})` : ({proveedor:'Publicado por el proveedor','red social':'Redes sociales',cliente:'Publicado por el negocio',institucional:etiquetaInst(c)})[c.fuenteTipo] ?? 'Prensa';
---
<article class="card" data-sector={c.sector} data-tarea={c.tarea} data-herr={HERR[herrMain(c)]} data-slug={c.slug} data-fuente={c.fuenteTipo || 'prensa'} data-pub={c.publicado} data-res={c.resultado && !c.patrocinado && c.fuenteTipo!=="proveedor"?1:0} data-ciudad={ciudadSlug(c) || ''} data-herrs={c.herramientas.join(' ')} data-text={norm([c.titulo,c.resumen,c.resultado,c.herramienta,...c.herramientas.map(h=>HERR[h]),c.ciudad,SECTORES[c.sector],TAREAS[c.tarea],c.fuente,c.patrocinado].filter(Boolean).join(' '))}>
<div class="head"><span class="badge" aria-hidden="true">{iniciales(c.herramienta)}</span><span class="who">{herrMain(c)==='ia-generica' ? <span>{HERR[herrMain(c)]}</span> : <a href={u(`/herramientas/${herrMain(c)}`)}>{HERR[herrMain(c)]}</a>}<small>{SECTORES[c.sector]}</small></span>{esNuevo && <span class="new">Nuevo</span>}</div>
<div class="meta">{c.patrocinado && <span class="new pat">Patrocinado ({c.patrocinado})</span>}{c.fuenteTipo === 'proveedor' ? <span class="new prov">Contenido de proveedor</span> : c.fuenteTipo === 'institucional' ? <span class="new prov">{etiquetaInst(c)}</span> : <span class="new src-t">{TIPO_LBL[c.fuenteTipo] ?? 'Prensa'}</span>}</div>
<h3><a href={u(`/casos/${c.slug}`)}>{c.titulo}</a></h3>
<p class={c.resultado ? 'res' : 'res none'}>{c.resultado ? c.resultado : 'Sin cifra publicada en la fuente'}</p>
<p class="sum">{c.resumen.length > 170 ? c.resumen.slice(0,168).replace(/\s\S*$/,'')+'…' : c.resumen}</p>
<div class="meta"><a class="tag" href={u(`/sector/${c.sector}`)}>{SECTORES[c.sector]}</a><a class="tag" href={u(`/tarea/${c.tarea}`)}>{TAREAS[c.tarea]}</a>{c.ciudad && (ciudadSlug(c) ? <a class="tag" href={u(`/ciudad/${ciudadSlug(c)}`)}>📍 {c.ciudad}</a> : <span class="tag">📍 {c.ciudad}</span>)}</div><span class="src">{fuenteLbl} · {c.fecha}</span>
<details><summary>Ver prompt</summary><pre>{c.prompt}</pre></details>
<div class="acts"><button class="cp" data-p={c.prompt}>Copiar prompt</button><button class="sh" data-u={u(`/casos/${c.slug}`)} data-t={c.titulo}>Compartir</button><button class="sv" aria-pressed="false">☆ Guardar</button></div>
</article>
