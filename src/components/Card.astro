---
import { SECTORES, TAREAS, u, slugify, herrBase, iniciales, HERR, herrMain } from '../data/meta.js';
const { c } = Astro.props;
const esNuevo = (Date.parse('2026-10-16') - Date.parse(c.publicado)) < 7*864e5;
const fuenteLbl = c.patrocinado ? `Contenido patrocinado (${c.patrocinado})` : ({proveedor:'Publicado por el proveedor','red social':'Redes sociales',cliente:'Publicado por el negocio'})[c.fuenteTipo] ?? 'Prensa';
---
<article class="card" data-sector={c.sector} data-tarea={c.tarea} data-herr={HERR[herrMain(c)]} data-slug={c.slug} data-text={(c.titulo+' '+c.resumen+' '+c.herramienta+' '+(c.ciudad||'')).toLowerCase()}>
<div class="meta"><span class="badge" aria-hidden="true">{iniciales(c.herramienta)}</span><a class="tag" href={u(`/herramientas/${herrMain(c)}`)}>{HERR[herrMain(c)]}</a>{esNuevo && <span class="new">Nuevo</span>}{c.patrocinado && <span class="new pat">Patrocinado ({c.patrocinado})</span>}{c.fuenteTipo === 'proveedor' && <span class="new prov">Contenido de proveedor</span>}</div>
<h3><a href={u(`/casos/${c.slug}`)}>{c.titulo}</a></h3>
<p class={c.resultado ? 'res' : 'res none'}>{c.resultado ? `📈 ${c.resultado}` : 'Sin cifra publicada en la fuente'}</p>
<p>{c.resumen.length > 170 ? c.resumen.slice(0,168).replace(/\s\S*$/,'')+'…' : c.resumen}</p>
<div class="meta"><a class="tag" href={u(`/sector/${c.sector}`)}>{SECTORES[c.sector]}</a><a class="tag" href={u(`/tarea/${c.tarea}`)}>{TAREAS[c.tarea]}</a>{c.ciudad && <a class="tag" href={u(`/ciudad/${slugify(c.ciudad)}`)}>📍 {c.ciudad}</a>}<span>{fuenteLbl} · {c.fecha}</span></div>
<details><summary>Ver prompt</summary><pre>{c.prompt}</pre></details>
<div class="acts"><button class="cp" data-p={c.prompt}>Copiar prompt</button><button class="sh" data-u={u(`/casos/${c.slug}`)} data-t={c.titulo}>Compartir</button><button class="sv" aria-pressed="false">☆ Guardar</button></div>
</article>
