---
import { SECTORES, TAREAS, u, slugify, herrBase, iniciales, HERR, herrMain } from '../data/meta.js';
const { c } = Astro.props;
const esNuevo = (Date.parse('2026-10-16') - Date.parse(c.publicado)) < 7*864e5;
const fuenteLbl = ({proveedor:'Publicado por el proveedor','red social':'Redes sociales',cliente:'Publicado por el negocio'})[c.fuenteTipo] ?? 'Prensa';
---
<article class="card" data-sector={c.sector} data-tarea={c.tarea} data-herr={HERR[herrMain(c)]} data-slug={c.slug} data-pub={c.publicado} data-res={c.resultado?1:0} data-text={(c.titulo+' '+c.resumen+' '+c.herramienta+' '+(c.ciudad||'')).toLowerCase()}>
<div class="head"><span class="badge" aria-hidden="true">{iniciales(c.herramienta)}</span><span class="who"><a href={u(`/herramientas/${herrMain(c)}`)}>{HERR[herrMain(c)]}</a><small>{SECTORES[c.sector]}</small></span>{esNuevo && <span class="new">Nuevo</span>}</div>
<h3><a href={u(`/casos/${c.slug}`)}>{c.titulo}</a></h3>
<p class={c.resultado ? 'res' : 'res none'}>{c.resultado ? c.resultado : 'Sin cifra publicada en la fuente'}</p>
<p class="sum">{c.resumen.length > 170 ? c.resumen.slice(0,168).replace(/\s\S*$/,'')+'…' : c.resumen}</p>
<div class="meta"><a class="tag" href={u(`/sector/${c.sector}`)}>{SECTORES[c.sector]}</a><a class="tag" href={u(`/tarea/${c.tarea}`)}>{TAREAS[c.tarea]}</a>{c.ciudad && <a class="tag" href={u(`/ciudad/${slugify(c.ciudad)}`)}>📍 {c.ciudad}</a>}</div><span class="src">{fuenteLbl} · {c.fecha}</span>
<details><summary>Ver prompt</summary><pre>{c.prompt}</pre></details>
<div class="acts"><button class="cp" data-p={c.prompt}>Copiar prompt</button><button class="sh" data-u={u(`/casos/${c.slug}`)} data-t={c.titulo}>Compartir</button><button class="sv" aria-pressed="false">☆ Guardar</button></div>
</article>
